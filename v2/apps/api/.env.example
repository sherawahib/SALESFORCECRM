# Neon PostgreSQL (use pooled connection string on Vercel)
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="change-me-in-production-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32"
API_PORT=4000
CORS_ORIGIN="http://localhost:7777"
UPLOAD_DIR="../../uploads"

# Vercel Cron auth (set in Vercel → Environment Variables)
CRON_SECRET="random-cron-secret"
